<?xml version="1.0"?>
<!--
  Controlled variant of the robot arm: the visualization model plus a
  ros2_control hardware interface.

  The plain robot_arm.urdf.xacro is deliberately left free of control tags so the
  RViz visualization path stays simple. Use this file whenever a
  controller_manager is involved.

    hardware:=mock     mock_components/GenericSystem - no simulator required
    hardware:=gazebo   gz_ros2_control/GazeboSimSystem - requires Gazebo Sim

  Expand it directly with:
    ros2 run xacro xacro robot_arm_control.urdf.xacro hardware:=mock
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm">

  <xacro:arg name="hardware" default="mock"/>

  <xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.urdf.xacro"/>
  <xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.ros2_control.xacro"/>

  <xacro:robot_arm_ros2_control hardware="$(arg hardware)"/>

</robot>
