<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm">
  <!-- CAD-derived upper-arm joint spacing; remaining dimensions are provisional. -->
  <xacro:property name="upper_arm_length" value="0.12"/>

  <!--
    Gripper travel. Zero is the STEP neutral pose, which is the closed gripper
    (2.65 mm between fingertips). Positive rotation opens the jaws; 0.30 rad
    gives roughly 49 mm of fingertip separation. This is a provisional
    kinematic limit and should be replaced with the measured mechanical stop.
  -->
  <xacro:property name="gripper_open" value="0.30"/>

  <!--
    Mass properties.

    Every mass and inertia below is computed by integrating the committed STL
    meshes (divergence theorem over the closed surface) and multiplying by
    pla_density. Nothing here is estimated by eye.

    Change pla_density alone and every mass and inertia rescales correctly,
    because the stored numbers are per-unit-density volume integrals.

    Cross-check: this method gives the upper arm 79.78 g. The analysis workbook
    implies 79.71 g for the same part (297.31 g shoulder-moving minus 217.60 g
    elbow-moving). Agreement is 0.1%, which independently validates both the
    integration and the density.

    KNOWN GAP - these are PRINTED-PART masses only. The workbook's moving-mass
    figures exceed the mesh sums by a near-constant 82.5 g at both the shoulder
    and the elbow, which is the servo, fastener, and hardware mass distal to the
    elbow. It is deliberately NOT distributed here: workbook validation item 3
    ("confirm the servo body mounting side for each joint") is still open, so
    assigning it to specific links would be a guess presented as a measurement.
    Add it once mounting sides are confirmed.

    ALSO PROVISIONAL - pla_density is the solid-model value. Workbook validation
    item 1 requires replacing it with slicer-estimated masses once infill, wall
    count, and supports are chosen. Expect the real printed parts to be lighter.
  -->
  <xacro:property name="pla_density" value="1240.0"/>

  <material name="dark_gray">
    <color rgba="0.22 0.24 0.27 1"/>
  </material>
  <material name="blue">
    <color rgba="0.12 0.32 0.80 1"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.35 0.08 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.00107986407 -6.18358027e-07 0.0221277793" rpy="0 0 0"/>
      <mass value="${9.47078684e-05 * pla_density}"/>
      <inertia ixx="${1.28706199e-07 * pla_density}" ixy="${3.46682081e-12 * pla_density}" ixz="${3.75517752e-09 * pla_density}"
               iyy="${1.34701532e-07 * pla_density}" iyz="${1.60120083e-12 * pla_density}"
               izz="${2.05376811e-07 * pla_density}"/>
    </inertial>

    <visual>
      <!-- SolidWorks exported the mesh Y-up; rotate it into ROS Z-up. -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh
          filename="package://robot_arm_description/STL/base_link.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- Collision: Cylinder: the base is genuinely round (40.5% of vertices lie in the outer 10% of
         radius) and a cylinder is 21% tighter than the bounding box. -->
    <collision>
      <origin xyz="0 -1.02849746e-07 0.0280000009" rpy="3.6732051e-06 -0 0"/>
      <geometry>
        <cylinder radius="0.0606250025" length="0.0560000017"/>
      </geometry>
    </collision>
  </link>

  <link name="waist_link">
    <inertial>
      <origin xyz="-0.00467023461 0.00793675396 0.0231640523" rpy="0 0 0"/>
      <mass value="${8.35641672e-05 * pla_density}"/>
      <inertia ixx="${6.2775338e-08 * pla_density}" ixy="${1.442602e-09 * pla_density}" ixz="${1.03593476e-08 * pla_density}"
               iyy="${8.8335047e-08 * pla_density}" iyz="${-7.61488194e-09 * pla_density}"
               izz="${6.83909909e-08 * pla_density}"/>
    </inertial>

    <visual>
      <!-- Rotate the Y-up CAD mesh into ROS Z-up, then yaw it into the CAD assembly orientation. -->
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh
          filename="package://robot_arm_description/STL/waist_link.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- Collision: Box: the waist is NOT round - only 8% of vertices lie in the outer 10% of radius,
         and a cylinder would be just 8% tighter than the box. Box chosen on that evidence. -->
    <collision>
      <origin xyz="1.35541332e-07 4.97871113e-13 0.0369000174" rpy="1.5708 -0 1.5708"/>
      <geometry>
        <box size="0.0968577415 0.0738000348 0.0970000029"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="waist_link"/>
    <!-- The CAD base is 56 mm tall, so place the waist directly on its top face. -->
    <origin xyz="0 0 0.056" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0.0599999261 0.00268461785 5.18655088e-07" rpy="0 0 0"/>
      <mass value="${6.43360473e-05 * pla_density}"/>
      <inertia ixx="${9.29897451e-09 * pla_density}" ixy="${-3.55309654e-13 * pla_density}" ixz="${-4.47940028e-12 * pla_density}"
               iyy="${1.08720531e-07 * pla_density}" iyz="${-5.45582481e-14 * pla_density}"
               izz="${1.03835897e-07 * pla_density}"/>
    </inertial>

    <visual>
      <!--
        STEP-derived mesh transform about the shoulder-servo shaft. The STL origin
        is 120 mm from the shoulder pivot and 10.5 mm from the link center plane.
      -->
      <origin xyz="0.12 -0.0105 0" rpy="-1.5708 1.5708 0"/>
      <geometry>
        <mesh
          filename="package://robot_arm_description/STL/upper_arm_link.stl"
          scale="1 1 1"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <!-- Collision: Box sized to the mesh bounding box in its own frame. -->
    <collision>
      <origin xyz="0.0599999609 -2.2053394e-07 2.2039245e-07" rpy="1.57079265 1.57079265 3.14159265"/>
      <geometry>
        <box size="0.0419998914 0.16196901 0.0209999997"/>
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="waist_link"/>
    <child link="upper_arm_link"/>
    <!-- Shoulder-servo shaft measured from RobotArmAssembly (1).STEP. -->
    <origin xyz="-0.01391 -0.0065 0.04028" rpy="3.1416 -1.503064 3.1416"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="forearm_link">
    <inertial>
      <origin xyz="0.0160694724 0.0163146104 -0.0445323533" rpy="0 0 0"/>
      <mass value="${5.72611052e-05 * pla_density}"/>
      <inertia ixx="${5.95331447e-08 * pla_density}" ixy="${2.59647282e-10 * pla_density}" ixz="${1.77838276e-08 * pla_density}"
               iyy="${6.99805381e-08 * pla_density}" iyz="${-7.1432358e-10 * pla_density}"
               izz="${1.71605271e-08 * pla_density}"/>
    </inertial>

    <visual>
      <!--
        STEP-derived transform relative to the corrected upper-arm mesh. The
        STL export shifted the Link #2 origin by +63, +19, +8 mm, so this
        translation compensates for that shift after applying the CAD rotation.
        This SolidWorks STL is millimeter-scaled, so convert it to meters.
      -->
      <origin xyz="0.008230 0.002500 0.033035"
              rpy="-1.570796 1.222882 0"/>
      <geometry>
        <mesh
          filename="package://robot_arm_description/STL/forearm_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <!-- Collision: Box sized to the mesh bounding box in its own frame. -->
    <collision>
      <origin xyz="0.0119116915 0.0160000062 -0.0331393786" rpy="-1.570796 1.222882 0"/>
      <geometry>
        <box size="0.124999993 0.037999997 0.027"/>
      </geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <!-- The upper arm extends along its link-frame +X axis. -->
    <origin xyz="${upper_arm_length} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="10.0" velocity="1.0"/>
  </joint>

  <!--
    Wrist. Link #3 is now its own moving link instead of part of a fixed
    wrist_gripper_link. The joint frame is the STEP wrist frame expressed in the
    forearm frame, so the mesh sits at the link origin and zero reproduces the
    STEP neutral pose exactly. The wrist frame's Y axis maps onto the forearm
    frame's Y axis, so the wrist pitches in the same plane as shoulder and elbow.
  -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="-2.42085612e-05 0.00594423645 0.0195846505" rpy="0 0 0"/>
      <mass value="${1.56507039e-05 * pla_density}"/>
      <inertia ixx="${3.64554578e-09 * pla_density}" ixy="${-2.24179141e-12 * pla_density}" ixz="${-6.90925407e-12 * pla_density}"
               iyy="${4.86784764e-09 * pla_density}" iyz="${-3.94886004e-10 * pla_density}"
               izz="${2.41509829e-09 * pla_density}"/>
    </inertial>

    <visual name="wrist_link_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://robot_arm_description/STL/wrist_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- Collision: Box sized to the mesh bounding box in its own frame. -->
    <collision>
      <origin xyz="0 0 0.023" rpy="0 -0 0"/>
      <geometry>
        <box size="0.033 0.028 0.046"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.033726552 0.016000000 -0.093875834"
            rpy="-3.141592654 0.347914624 -3.141592654"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Gripper base, rigidly bolted to the wrist. -->
  <link name="gripper_base_link">
    <inertial>
      <origin xyz="0.00318308193 0.00755952549 -0.0130397199" rpy="0 0 0"/>
      <mass value="${1.60468383e-05 * pla_density}"/>
      <inertia ixx="${7.26166118e-09 * pla_density}" ixy="${4.03840618e-10 * pla_density}" ixz="${-1.7881094e-09 * pla_density}"
               iyy="${9.01153601e-09 * pla_density}" iyz="${1.3403234e-09 * pla_density}"
               izz="${3.29863321e-09 * pla_density}"/>
    </inertial>

    <visual name="gripper_base_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/STL/gripper_base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- Collision: Box sized to the mesh bounding box. Loose (7.2x the true volume) because the
         part is an open forked bracket; a convex hull would be tighter if needed. -->
    <collision>
      <origin xyz="0.0116501546 0.0139999983 -0.0134966087" rpy="0 -0 0"/>
      <geometry>
        <box size="0.0532997427 0.0279999996 0.0770036621"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0.034300380 0.013001510 0.047026012"
            rpy="-1.363351778 0 -1.570796327"/>
  </joint>

  <!--
    Gripper sides.

    The real mechanism is a geared four-bar closed loop: each gear drives a
    connecting link that drives a finger. URDF cannot express a closed kinematic
    chain, so each side is approximated as ONE rigid body - gear, connecting
    link, and finger together - pivoting about its gear axis. The connecting
    link and finger therefore do not articulate relative to their gear; this is
    a visual and workspace approximation, not a mechanism simulation.

    Both gear frames share a common spin axis: the left and right local Z axes
    are exactly anti-parallel in the gripper-base frame (dot product -1.000000),
    which is the meshing-gear signature. Because the axes are anti-parallel,
    driving both sides with the SAME signed angle produces true counter-rotation
    in world space, so the mimic multiplier is +1, not -1.
  -->
  <link name="left_gripper_link">
    <inertial>
      <origin xyz="0.021491332 0.00285382366 0.00278880384" rpy="0 0 0"/>
      <mass value="${9.95847365e-06 * pla_density}"/>
      <inertia ixx="${5.28681477e-10 * pla_density}" ixy="${-7.45464239e-10 * pla_density}" ixz="${6.95154139e-10 * pla_density}"
               iyy="${6.77579585e-09 * pla_density}" iyz="${8.57273891e-11 * pla_density}"
               izz="${6.9847835e-09 * pla_density}"/>
    </inertial>

    <visual name="left_gear_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/STL/gripper_gear.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <visual name="left_connecting_link_visual">
      <origin xyz="0.035504505 0.008743617 0.004000000"
              rpy="-3.141592654 0 -0.009919099"/>
      <geometry>
        <mesh filename="package://robot_arm_description/STL/gripper_connecting_link.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <visual name="left_finger_visual">
      <origin xyz="0.040876871 0.004294937 0"
              rpy="-3.141592654 0 0.401119022"/>
      <geometry>
        <mesh filename="package://robot_arm_description/STL/gripper_finger.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- Collision: Finger only. The gear and connecting link are internal mechanism that mesh and
         overlap by design, so collision geometry there would create permanent contact. -->
    <collision>
      <origin xyz="0.0576946969 0.00715333915 -0.00224999852" rpy="3.14159265 -0 0.401119022"/>
      <geometry>
        <box size="0.0651637421 0.0178700542 0.00450000009"/>
      </geometry>
    </collision>
  </link>

  <!-- Actuated gripper side. This is the single user-facing gripper control. -->
  <joint name="gripper_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="left_gripper_link"/>
    <origin xyz="0.016900000 0 0"
            rpy="3.141592654 -1.570796327 -1.570796327"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="${gripper_open}" effort="5.0" velocity="1.0"/>
  </joint>

  <link name="right_gripper_link">
    <inertial>
      <origin xyz="0.0211377991 0.00379476019 0.00721119918" rpy="0 0 0"/>
      <mass value="${9.95847365e-06 * pla_density}"/>
      <inertia ixx="${6.62256377e-10 * pla_density}" ixy="${-1.08780871e-09 * pla_density}" ixz="${-6.81478036e-10 * pla_density}"
               iyy="${6.53666692e-09 * pla_density}" iyz="${-1.26132506e-10 * pla_density}"
               izz="${6.87922951e-09 * pla_density}"/>
    </inertial>

    <visual name="right_gear_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/STL/gripper_gear.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <visual name="right_connecting_link_visual">
      <origin xyz="0.034336030 0.010701831 0.006000000"
              rpy="0 0 -3.125893888"/>
      <geometry>
        <mesh filename="package://robot_arm_description/STL/gripper_connecting_link.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <visual name="right_finger_visual">
      <origin xyz="0.040292060 0.005472576 0.014500000"
              rpy="-3.141592654 0 0.520722397"/>
      <geometry>
        <mesh filename="package://robot_arm_description/STL/gripper_finger.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <!-- Collision: Finger only, mirroring the left side. -->
    <collision>
      <origin xyz="0.0566486799 0.0103172343 0.0122500015" rpy="3.14159265 -0 0.520722397"/>
      <geometry>
        <box size="0.0651637421 0.0178700542 0.00450000009"/>
      </geometry>
    </collision>
  </link>

  <!--
    Mirrored side. The mimic tag keeps this passive, so joint_state_publisher_gui
    exposes exactly five controls: base yaw, shoulder, elbow, wrist, and gripper.
  -->
  <joint name="right_gripper_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="right_gripper_link"/>
    <origin xyz="-0.009999717 -0.010000000 0"
            rpy="1.570796327 -1.444499427 3.141592654"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="${gripper_open}" effort="5.0" velocity="1.0"/>
    <mimic joint="gripper_joint" multiplier="1.0" offset="0.0"/>
  </joint>
</robot>
