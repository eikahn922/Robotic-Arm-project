<?xml version="1.0"?>
<package format="3">
  <name>robot_arm_description</name>
  <version>0.1.0</version>
  <description>ROS 2 description and visualization package for a 3-DOF robotic arm.</description>

  <maintainer email="eikahn@andrew.cmu.edu">Ezra Kahn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>urdf_launch</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
